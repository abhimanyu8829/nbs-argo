# ============================================================
# EDIT THIS FILE FIRST — then run the numbered scripts in order.
# All 01-*.sh .. 12-*.sh scripts source this file automatically.
# ============================================================

# AWS region for the deployment
AWS_REGION="ap-south-1"

# Postgres password — CHANGE THIS. Do not use the old default
# (nitroberry-prod-db-pass).
POSTGRES_PASSWORD="CHANGE-ME-TO-A-REAL-PASSWORD"

# Only needed if using Azure Key Vault for secrets. Leave blank to skip.
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""

# Where the repo will be cloned to / already lives
REPO_DIR="$HOME/NitroBerry-Platform"

# Repo details (only change if using a fork/different branch)
GIT_REPO_URL="https://github.com/dushyantajangid/NitroBerry-Platform.git"
GIT_BRANCH="argocdTest"

# Your OCI instance public IP — used only in the printed SSH-tunnel command
# in 11-access-argocd-ui.sh. Not required for anything else to run.
OCI_PUBLIC_IP="CHANGE-ME"

# Path to your SSH key — same, only used in a printed reminder command.
SSH_KEY_PATH="/path/to/your-key.pem"
